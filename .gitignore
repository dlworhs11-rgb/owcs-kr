# publish only the site, the cloud build (owcs_build.py, owcs_cloud.py, cloud_live.py: no local paths) and the data
# files it needs; everything else stays on this PC
/*
!/.gitignore
!/.github/
!/assets/
!/index.html
!/*.html
/OWCS KR 테스트.html
!/owcs-*.js
!/support.js
!/cloud_live.py
!/owcs_cloud.py
!/owcs_build.py
!/data/
/data/*
!/data/socials.json
!/data/faces.json
!/data/achievements.json
!/data/picks.json
!/data/insta_posts.txt
!/data/insta_meta.json
!/data/live_scores/
!/data/live_maps/
!/data/live_sets/

# built by GitHub Actions on every deploy (cloud_live.py); the PC copy is only for the local preview
/owcs-data.js
owcs-kr-upcoming*.ics
